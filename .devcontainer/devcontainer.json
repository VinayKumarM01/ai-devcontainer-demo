{
  "name": "ai-devcontainer-demo",
  "image": "eclipse-temurin:25-jdk",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/java:1": {
			"version": "none",
			"installMaven": "true",
			"installGradle": "false"
		}
  },
  "remoteEnv": {
    "JAVA_HOME": "/opt/java/openjdk",
    "PATH": "/opt/java/openjdk/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  }
}
